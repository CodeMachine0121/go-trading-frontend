{
  "name": "go-trading-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "bun run lint && bun run lint:style && bun run typecheck && bun run test",
    "postinstall": "nuxt prepare",
    "prepare": "husky",
    "lint:style": "stylelint \"app/**/*.{scss,vue}\"",
    "lint:style:fix": "stylelint \"app/**/*.{scss,vue}\" --fix"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.10",
    "codemirror": "^6.0.2",
    "decimal.js": "^10.6.0",
    "nuxt": "^3.21.11",
    "vue": "^3.5.42",
    "vue-router": "^5.3.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^10.9.1",
    "happy-dom": "^20.11.15",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "ofetch": "^1.5.1",
    "postcss-html": "^2.0.0",
    "sass-embedded": "^1.103.1",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "lint-staged": {
    "*.{ts,mts,js,mjs,vue}": "eslint --fix",
    "*.{scss,vue}": "stylelint --fix"
  },
  "trustedDependencies": [
    "esbuild",
    "unrs-resolver"
  ]
}
